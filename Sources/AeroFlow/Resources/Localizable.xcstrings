    "Grant Input Monitoring in System Settings, or reassign the chord.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定で入力監視を許可するか、コードを再割り当てします。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie die Eingabeüberwachung in den Systemeinstellungen frei oder weisen Sie den Chord neu zu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gi tillatelse til inndataovervåking i Systeminnstillinger, eller tildel tastekombinasjonen på nytt."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ge tillstånd för inmatningsövervakning i Systeminställningar, eller tilldela tangentkombinationen på nytt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Concede el permiso de Monitoreo de entrada en Configuración del sistema o vuelve a asignar la combinación de teclas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“系统设置”中授予输入监控权限，或重新设置该快捷键组合。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिस्टम सेटिंग्स में ग्रांट इनपुट मॉनिटरिंग करें, या कॉर्ड को पुनः असाइन करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "امنح إذن مراقبة الإدخال من إعدادات النظام، أو أعد تعيين مجموعة المفاتيح."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Omogućite praćenje unosa u Sistemskim podešavanjima ili promenite kombinaciju tastera."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χορηγήστε άδεια Παρακολούθησης εισόδου στις Ρυθμίσεις συστήματος ή αντιστοιχίστε ξανά τον συνδυασμό πλήκτρων."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "העניקו הרשאת ניטור קלט בהגדרות המערכת, או הקצו צירוף מקשים אחר."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предоставьте разрешение «Мониторинг ввода» в Системных настройках или назначьте другое сочетание клавиш."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przyznaj uprawnienie Monitorowanie wejścia w Ustawieniach systemowych albo przypisz inny skrót klawiszowy."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надайте дозвіл на Моніторинг введення в Системних параметрах або призначте іншу комбінацію клавіш."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accordez l’autorisation Surveillance de l’entrée dans Réglages Système, ou attribuez une autre combinaison de touches."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geef in Systeeminstellingen toestemming om invoer te monitoren, of wijs een andere toetscombinatie toe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Grant Input Monitoring in Impostazioni di sistema, o riassegnare l'accordo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Grant Input Monitoring in System Settings, tai siirtää sointu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Grant Input Overvågning i Systemindstillinger, eller omplacer akkorden."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정에서 입력 모니터링 권한을 부여하거나 다른 키 조합을 지정하세요."
          }
        }
      }
    },
