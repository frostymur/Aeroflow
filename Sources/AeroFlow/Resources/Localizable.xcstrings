    "Enable Dock auto-hide in System Settings → Desktop & Dock, or move the Dock off the parking edge.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定→デスクトップとドックで「ドックの自動非表示を有効にする」をオンにするか、ドックを駐車エッジから離してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivieren Sie die automatische Ausblendung des Docks in den Systemeinstellungen → Desktop & Dock oder verschieben Sie das Dock vom Parkrand."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiver automatisk skjuling av Dock i Systeminnstillinger → Skrivebords- og Dock-innstillinger, eller flytt Docken bort fra parkeringskanten."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivera att fönstret Auto-döljs i fönstret Dock i Systeminställningar → Fönster och docka, eller flytta fönstret Dock från parkeringskanten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa el ocultamiento automático del Dock en Configuración del sistema → Escritorio y Dock, o mueve el Dock fuera del borde de estacionamiento."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在系统设置 → 桌面和Dock中启用Dock自动隐藏，或将Dock移出停车边缘。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिस्टम सेटिंग्स → डेस्कटॉप और डॉक में डॉक ऑटो-हाइड को सक्षम करें, या डॉक को पार्किंग किनारे से दूर ले जाएं।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتفعيل إخفاء Dock التلقائي في إعدادات النظام → سطح المكتب والـ Dock، أو انقل Dock بعيدًا عن حافة موقف السيارات."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Omogućite automatsko sakrivanje Dock u sistemskim postavkama → Desktop & Dock, ili prebacite Dock sa parkirališta."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ενεργοποιήστε την αυτόματη απόκρυψη του Dock στις Ρυθμίσεις συστήματος → Γραφείο εργασίας και Dock ή μετακινήστε το Dock μακριά από την πλευρά στάθμευσης παραθύρων."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפעילו הסתרה אוטומטית של ה-Dock בהגדרות המערכת → מכתבה ו-Dock, או הזיזו את ה-Dock מקצה החניה."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите автоматическое скрытие панели задач в настройках системы → Рабочая станция и панель задач, или переместите панель задач подальше от края парковки."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącz automatyczne ukrywanie Docka w ustawieniach systemowych → Pulpit i Dock, lub przenieś Dock z poza krawędź parkingową."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкніть автоматичне приховування Dock у Системні параметри → Робочий стіл і Dock або перемістіть Dock від краю, де розміщуються припарковані вікна."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez le masquage automatique du Dock dans Réglages Système → Bureau et Dock, ou éloignez le Dock du bord où les fenêtres sont garées."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel het automatisch verbergen van het Dock in via Systeeminstellingen → Bureaublad en Dock, of verplaats het Dock weg van de rand waar vensters worden geparkeerd."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abilita Nascondi automaticamente il Dock nelle impostazioni di sistema → Desktop & Dock, o sposta il Dock dal bordo del parcheggio."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käytä Dockin automaattista piilotusta Järjestelmäasetuksissa → Desktop & Dock, tai siirrä Dock pois pysäköinnin reunalta."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivér Dock auto- skjul i Systemindstillinger → Desktop & Dock, eller fjern Dock fra parkeringskanten."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정 → 데스크톱 및 도크에서 도크 자동 숨기기를 활성화하거나 도크를 주차 모서리에서 멀리 이동합니다."
          }
        }
      }
    },
    "Enable “Displays have separate Spaces”": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「ディスプレイに個別のスペースを表示する」を有効にする"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivieren Sie „Displays haben separate Plätze“"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiver «Skjermer har separate mellomrom»"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivera ”Bildskärmar har egna Spaces”"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Habilitar \"Las pantallas tienen espacios separados\""
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用“显示器有独立的空间”"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\"डिस्प्ले में अलग-अलग स्पेस\" सक्षम करें"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمكين \"تظهر الشاشات مساحات منفصلة\""
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Omogućava se \"Ekrani imaju odvojene prostore\""
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ενεργοποίηση «Οι οθόνες έχουν ξεχωριστούς Χώρους»"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפעלת ״הצגים כוללים Spaces נפרדים״"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите «На отображении есть отдельные места»."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącz „Osobne przestrzenie dla wyświetlaczy”"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкнути «Окремі простори на дисплеях»"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activer les affichages ont des espaces séparés."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inschakelen van \"Displays\" hebben aparte spaties"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abilita i Display hanno Spazi separati"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ota käyttöön levyt, joissa on erilliset välilyönnit"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivér Displays har separate mellemrum"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“각각의 Spaces가 있는 디스플레이” 켜기"
          }
        }
      }
    },
    "Fixed Dock detected on %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixed Dock detected on %@"
          }
        }
      }
    },
