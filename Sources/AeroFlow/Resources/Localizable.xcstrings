    "Press to switch Spaces. The tiling position remains reserved.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スペースを切り替えるには、押してください。タイルの位置は予約されたままです。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drücken Sie, um die Plätze zu wechseln. Die Verlegungsposition bleibt reserviert."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk for å bytte mellom rom. Plasseringen for flisleggingen forblir reservert."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck för att växla mellan Spaces. Fönstrets plats i plattsättningen förblir reserverad."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Presione para cambiar los espacios. La posición del azulejo permanece reservada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按下可切换空间。平铺位置会保留。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्पेस बदलने के लिए दबाएं। टाइलिंग की स्थिति सुरक्षित रहेगी।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط لتغيير المساحات. يظل موقع التغطية محجوزًا."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Pritisnite da prebacite prostore. Pozicija je rezervisana."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πατήστε για εναλλαγή Χώρων. Η θέση του παραθύρου στην παράθεση παραμένει δεσμευμένη."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לחץ על מנת להחליף חללים. עמדת העיתוי נשארת שמורה."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите, чтобы переключить пространства. Позиция окна в мозаичной раскладке останется зарезервированной."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naciśnij, aby przełączyć przestrzenie. Pozycja układu pozostaje zarezerwowana."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть, щоб перемкнути простір. Місце в мозаїчному розташуванні залишається зарезервованим."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur pour changer d'espaces. La position de carrelage reste réservée."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Druk op Spaces om te schakelen. De tegelpositie blijft gereserveerd."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Premere per cambiare spazi. La posizione della piastrellatura rimane riservata."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Paina vaihtaaksesi välilyöntiä. Kastelupaikka on edelleen varattu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på for at skifte mellemrum. Flisepositionen forbliver reserveret."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공간을 전환하려면 누르세요. 타일링 위치는 그대로 예약되어 있습니다."
          }
        }
      }
    },
    "Press to switch to the app's macOS Full Screen Space. Its tiling position remains reserved.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリのmacOSフルスクリーンスペースに切り替えるには、押してください。タイル配置の位置はそのまま保持されます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drücken Sie, um zum Full-Screen-Bereich macOS der App zu wechseln. Seine Fliesenposition bleibt reserviert."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk for å bytte til appens macOS Fullskjermplass. Plasseringen for tiling forblir reservert."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck för att byta till appens macOS Fullskärmsutrymme. Dess tilingposition förblir reserverad."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Presione para cambiar al espacio de pantalla completa macOS de la aplicación. Su posición de disposición sigue reservada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按一下切换到应用程序的macOS全屏空间。其拼贴位置仍然保留。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप के macOS फुल स्क्रीन स्पेस में स्विच करने के लिए दबाएं। इसकी टाइलिंग स्थिति आरक्षित रहेगी।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط للتبديل إلى مساحة الشاشة الكاملة macOS في التطبيق. يظل موقع التغطية محجوزًا."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Pritisnite da biste prešli na macOS Full Screen Space aplikacije. Njegova pozicija ostaje rezervisana."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πατήστε για μετάβαση στον χώρο πλήρους οθόνης της εφαρμογής στο macOS. Η θέση της στην παράθεση παραμένει δεσμευμένη."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לחץ על מנת לעבור לאפליקציה macOS שטח מסך מלא. עמדת העיתוי שלו נשארת שמורה."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите, чтобы перейти в режим macOS полного экрана приложения. Его расположение в сетке остаётся зарезервированным."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naciśnij, aby przejść do pełnoekranowego przestrzeń robocza macOS aplikacji. Jej pozycja układu pozostaje zarezerwowana."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть, щоб перейти до повноекранного простору програми в macOS. Її місце в мозаїчному розташуванні залишається зарезервованим."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur pour passer à l'espace plein écran de l'application macOS. Sa position de carrelage reste réservée."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Druk om te schakelen naar de app's macOS Volledige schermruimte. De tegelpositie blijft gereserveerd."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Premere per passare allo spazio a schermo intero macOS dell'app. La sua posizione di rivestimento rimane riservata."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Paina vaihtaaksesi sovelluksen macOS koko näyttötilaan. Sen väsymisasento on edelleen varattu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på for at skifte til appens macOS Fuldskærmsplads. Dens flise position forbliver reserveret."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱의 macOS 풀스크린 공간으로 전환하려면 누르세요. 타일링 위치는 그대로 유지됩니다."
          }
        }
      }
    },
    "Rank %lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rank %lld"
          }
        }
      }
    },
    "Reassign this command in Hotkeys, or clear the conflicting shortcut in System Settings → Keyboard.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホットキーでこのコマンドを再割り当てするか、システム設定→キーボードで競合するショートカットをクリアしてください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weisen Sie diesen Befehl in Hotkeys um oder löschen Sie die widersprüchliche Shortcut-Taste in Systemeinstellungen → Tastatur."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Omfordel denne kommandoen i hurtigtaster, eller slett den motstridende hurtigtasten i Systeminnstillinger → Tastatur."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilldela om detta kommando i genvägar, eller rensa den krockande genvägen i Systeminställningar → Tangentbord."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reasigna este comando en Atajos de teclado, o elimina el atajo de teclado conflictivo en Configuración del sistema → Teclado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在快捷键中重新分配此命令，或在系统设置 → 键盘中清除冲突的快捷键。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस कमांड को हॉटकीज में पुनः असाइन करें, या सिस्टम सेटिंग्स → कीबोर्ड में टकराव वाले शॉर्टकट को साफ़ करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعد تعيين هذا الأمر في مفاتيح الاختصار الساخنة، أو قم بتنظيف الاختصار المتضارب في إعدادات النظام → لوحة المفاتيح."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponovo dodelite ovu zapovest u Hotkeys-u ili očistite sukob u sistemskim postavkama → tipkovnici."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αντιστοιχίστε ξανά αυτή την εντολή στις Συντομεύσεις ή διαγράψτε τη συντόμευση που συγκρούεται στις Ρυθμίσεις συστήματος → Πληκτρολόγιο."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקצו מחדש את הפקודה הזו תחת קיצורי מקשים, או הסירו את קיצור הדרך המתנגש בהגדרות המערכת → מקלדת."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переназначите этот команд в горячих клавишах или удалите конфликтающие сочетания клавиш в настройках системы → Клавиатура."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przypisz to polecenie ponownie w sekcji Skróty klawiszowe albo usuń kolidujący skrót w Ustawieniach systemowych → Klawiatura."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перепризначте цю команду в розділі «Комбінації клавіш» або видаліть конфліктне скорочення в Системні параметри → Клавіатура."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réaffectez cette commande dans Raccourcis clavier, ou supprimez le raccourci en conflit dans Réglages Système → Clavier."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wijs deze opdracht opnieuw toe onder Sneltoetsen, of verwijder de conflicterende toetscombinatie in Systeeminstellingen → Toetsenbord."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riassegnare questo comando in tasti di scelta rapida, o cancellare la scorciatoia in conflitto in Impostazioni di sistema → Tastiera."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lähetä tämä komento uudelleen pikanäppäimillä, tai poista järjestelmän asetusten ristiriitainen pikanäppäin → Näppäimistö."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gentildele denne kommando i Hotkeys, eller rydde den modstridende genvej i Systemindstillinger → Keyboard."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단축키에서 이 명령을 다른 키 조합에 할당하거나 시스템 설정 → 키보드에서 충돌하는 단축키를 해제하세요."
          }
        }
      }
    },
    "Reassign this command to a free chord in Hotkeys.": {
      "localizations": {
