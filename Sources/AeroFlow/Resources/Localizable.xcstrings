    "Invalid settings left untouched": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無効な設定がそのまま残っています"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ungültige Einstellungen wurden unberührt gelassen"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ugyldige innstillinger forlatt uendret"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogiltiga inställningar lämnades orörda"
          }
        },
        "es": {
