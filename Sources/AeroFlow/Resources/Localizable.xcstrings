    "Arrange displays vertically or diagonally in System Settings → Displays so frames do not overlap.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定→ディスプレイで、フレームが重ならないように、ディスプレイを縦または横に配置します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Richten Sie Anzeigen vertikal oder diagonal in den Systemeinstellungen → Anzeigen so an, dass sich die Frames nicht überschneiden."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Arranger skjermer vertikalt eller diagonalt i Systeminnstillinger → Skjermer slik at rammene ikke overlapper hverandre."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrangera skärmar vertikalt eller diagonalt i Systeminställningar → Skärmar så att ramarna inte överlappar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Organiza las pantallas vertical o diagonalmente en Configuración del sistema → Pantallas para que los cuadros no se superpongan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在系统设置 → 显示中垂直或对角排列显示器，以防止帧重叠。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिस्टम सेटिंग्स → डिस्प्ले में डिस्प्ले को ऊर्ध्वाधर या तिरछे व्यवस्थित करें ताकि फ्रेम ओवरलैप न हों।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بترتيب العروض بشكل عمودي أو قطري في إعدادات النظام → العروض بحيث لا تتداخل الإطارات."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Poređenje ekrana vertikalno ili dijagonalno u Podešavanjama sistema → Pokazati tako da okviri ne preklapaju."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τακτοποιήστε τις οθόνες κάθετα ή διαγώνια στις Ρυθμίσεις Συστήματος → Εμφανίσεις έτσι ώστε τα πλαίσια να μην επικαλύπτονται."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סדרו את הצגים אנכית או באלכסון בהגדרות המערכת → צגים כדי שהמסגרות לא יחפפו."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разместите отображения вертикально или диагонально в настройках системы → Отображения, чтобы кадры не пересекались."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustaw wyświetlacze pionowo lub ukośnie w ustawieniach systemowych → Wyświetlacz, aby ramki nie nakładały się na siebie."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розташуйте дисплеї вертикально або по діагоналі в Системні параметри → Дисплеї, щоб їхні рамки не перекривалися."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans Réglages Système → Moniteurs, disposez les écrans verticalement ou en diagonale pour éviter que leurs cadres se chevauchent."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rangschik de beeldschermen verticaal of diagonaal in Systeeminstellingen → Beeldschermen, zodat de schermkaders elkaar niet overlappen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disporre i display verticalmente o diagonalmente in Impostazioni di sistema → Display in modo che i frame non si sovrappongano."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Järjestä näytöt pysty- tai diagonaalisesti System Settings → Näytöt, jotta kehykset eivät ole päällekkäin."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Arranger skærme lodret eller diagonalt i Systemindstillinger → Viser, så rammer ikke overlapper."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정 → 디스플레이에서 화면이 겹치지 않도록 프레임을 수직 또는 대각선으로 정렬합니다."
          }
        }
      }
    },
    "Assign a unique chord to one of the commands in Hotkeys.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホットキーのコマンドのいずれかにユニークなコードを割り当てます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weisen Sie einem der Befehle in Hotkeys einen einzigartigen Akkord zu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tildel en unik akkord til en av kommandoene i Hurtigtaster."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilldela en unik ackord till en av kommandona i Hotkeys."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Asigna un acorde único a uno de los comandos en Hotkeys."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为Hotkeys中的一个命令分配一个唯一的和弦。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हॉटकीज़ में कमांड में से एक को एक अद्वितीय कॉर्ड असाइन करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عيّن نغمة فريدة لأحد الأوامر في مفاتيح الاختصار الساخنة."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Prisvojite jedinstvenu ordu na jednu od komanda u Hotkeisu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αντιστοιχίστε έναν μοναδικό συνδυασμό πλήκτρων σε μία από τις εντολές στις Συντομεύσεις."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקצו צירוף מקשים ייחודי לאחת הפקודות בהגדרות קיצורי המקשים."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Привяжите уникальный ударный ключ к одному из команд в горячих клавишах."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przypisz unikalną kombinację klawiszy do jednego z poleceń w sekcji Skróty klawiszowe."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Призначте унікальну комбінацію клавіш одній із команд у розділі «Комбінації клавіш»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Attribuez une combinaison de touches unique à l’une des commandes dans Raccourcis clavier."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wijs een unieke toetscombinatie toe aan een van de opdrachten onder Sneltoetsen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Assegna un accordo unico ad uno dei comandi di Hotkey."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Osoita ainutlaatuinen sointu yhdelle Hotkeysin komennosta."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tildel en unik akkord til en af kommandoerne i Hotkeys."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단축키에서 명령 하나에 고유한 키 조합을 할당하세요."
          }
        }
      }
    },
    "Click a segment to select that tab.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セグメントをクリックして、そのタブを選択します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicken Sie auf ein Segment, um diesen Tab auszuwählen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Klikk på et segment for å velge den fanen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicka på ett segment för att välja den fliken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en un segmento para seleccionar esa pestaña."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击一个部分以选择该选项卡。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उस टैब को चुनने के लिए एक खंड पर क्लिक करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر على جزء لتحديد هذا التبويب."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknite na segment da biste izabrali tab."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάντε κλικ σε ένα τμήμα για να επιλέξετε αυτή την καρτέλα."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לחץ על קטע כדי לבחור את הלשונית."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите на сегмент, чтобы выбрать эту вкладку."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknij sekcję, aby wybrać zakładkę."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть сегмент, щоб вибрати вкладку."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur un segment pour sélectionner cet onglet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik op een segment om dat tabblad te selecteren."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fare clic su un segmento per selezionare quella scheda."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse välilehti klikkaamalla segmenttiä."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik på et segment for at vælge dette faneblad."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세그먼트를 클릭하여 해당 탭을 선택합니다."
          }
        }
      }
    },
    "Click an app icon to select its window. Scroll to see more tabs.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリのアイコンをクリックしてウィンドウを選択します。さらにタブを見るにはスクロールします。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicken Sie auf ein App-Symbol, um das Fenster auszuwählen. Scrollen Sie nach unten, um weitere Registerkarten anzuzeigen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Klikk på et appikon for å velge vinduet. Rull for å se flere faner."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicka på en appikon för att välja dess fönster. Rulla för att se fler flikar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en el icono de una aplicación para seleccionar su ventana. Desplázate para ver más pestañas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击应用程序图标以选择其窗口。滚动查看更多标签页。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी विंडो चुनने के लिए ऐप आइकन पर क्लिक करें। अधिक टैब देखने के लिए स्क्रॉल करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر على أي أيقونة تطبيق لتحديد نافذته. قم بالتمرير لرؤية المزيد من القوائم."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknite na ikonu aplikacije da biste izabrali njeno prozor. Preuzmite da biste videli više tabs."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάντε κλικ σε ένα εικονίδιο εφαρμογής για να επιλέξετε το παράθυρό του. Πήγαινε να δεις κι άλλες καρτέλες."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לחץ על סמל אפליקציה כדי לבחור את החלון. גלול כדי לראות עוד כרטיסיות."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите на иконку приложения, чтобы выбрать его окно. Прокрутите страницу, чтобы увидеть больше вкладки."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknij ikonę aplikacji, aby wybrać jej okno. Przewiń, aby zobaczyć więcej klawiatur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть іконку програми, щоб вибрати її вікно. Прокрутіть, щоб побачити більше вкладок."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur une icône d'application pour sélectionner sa fenêtre. Faites défiler pour voir plus d'onglets."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik op een app pictogram om het venster te selecteren. Scroll om meer tabbladen te zien."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fare clic su un'icona dell'app per selezionare la sua finestra. Scorri per vedere altre schede."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Klikkaa sovelluksen kuvaketta valitaksesi sen ikkunan. Klikkaa nähdäksesi lisää välilehtiä."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik på et app-ikon for at vælge dets vindue. Rul for at se flere faneblade."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 아이콘을 클릭하여 창을 선택합니다. 더 많은 탭을 보려면 스크롤하세요."
          }
        }
      }
    },
    "Compare %@ with %@, restore valid values, and then remove the recovery file.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare %@ with %@, restore valid values, and then remove the recovery file."
          }
        }
      }
    },
    "Correct the reported value at %@; AeroFlow applies the file once it decodes. Saving from the Settings window first secures the rejected bytes as a recovery file.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Correct the reported value at %@; AeroFlow applies the file once it decodes. Saving from the Settings window first secures the rejected bytes as a recovery file."
          }
        }
      }
    },
