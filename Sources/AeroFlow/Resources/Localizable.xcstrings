    "Open System Settings → Privacy & Security → Accessibility and enable AeroFlow.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定を開く → プライバシーとセキュリティ → アクセシビリティを開き、AeroFlowを有効にします。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen Sie die Systemeinstellungen → Datenschutz und Sicherheit → Barrierefreiheit und aktivieren Sie AeroFlow."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpne Systeminnstillinger → Personvern og sikkerhet → Tilgjengelighet og aktiver AeroFlow."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppna Systeminställningar → Integritet och säkerhet → Hjälpmedel och aktivera AeroFlow."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Configuración del sistema → Privacidad y seguridad → Accesibilidad y habilita AeroFlow."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开“系统设置”→“隐私与安全性”→“辅助功能”，然后启用 AeroFlow。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिस्टम सेटिंग्ज़ → गोपनीयता और सुरक्षा → ऐक्सेसिबिलिटी खोलें और AeroFlow को अनुमति दें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح إعدادات النظام → الخصوصية والأمان → إمكانية الوصول وقم بتفعيل AeroFlow."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvorite Sistemska podešavanja → Privatnost i bezbednost → Pristupačnost i omogućite AeroFlow."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανοίξτε τις Ρυθμίσεις συστήματος → Απόρρητο και ασφάλεια → Προσβασιμότητα και ενεργοποιήστε το AeroFlow."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פתחו את הגדרות המערכת → פרטיות ואבטחה → נגישות והפעילו את AeroFlow."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте «Системные настройки» → «Конфиденциальность и безопасность» → «Универсальный доступ» и включите AeroFlow."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz Ustawienia systemowe → Prywatność i ochrona → Dostępność i włącz AeroFlow."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрийте Системні параметри → Приватність і безпека → Доступність і ввімкніть AeroFlow."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez Réglages Système → Confidentialité et sécurité → Accessibilité, puis activez AeroFlow."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Systeeminstellingen → Privacy en beveiliging → Toegankelijkheid en schakel AeroFlow in."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri Impostazioni di Sistema → Privacy e sicurezza → Accessibilità e abilita AeroFlow."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa Järjestelmäasetukset → Tietosuoja ja suojaus → Käyttöapu ja ota AeroFlow käyttöön."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbn Systemindstillinger → Anonymitet & sikkerhed → Tilgængelighed, og slå AeroFlow til."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정 → 개인정보 보호 및 보안 → 손쉬운 사용을 열고 AeroFlow을 켜세요."
          }
        }
      }
    },
