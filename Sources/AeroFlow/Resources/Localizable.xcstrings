    "macOS or another app already uses this shortcut.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS または他のアプリがすでにこのショートカットを使用しています。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS oder eine andere App verwendet bereits diese Kurzschrift."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS eller en annen applikasjon bruker allerede denne snarveien."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS eller en annan app använder redan den här genvägen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS o otra aplicación ya utiliza este atajo de teclado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS或其他应用程序已经使用这个快捷键。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS या कोई अन्य ऐप पहले से ही इस शॉर्टकट का उपयोग कर रहा है।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS أو تطبيق آخر يستخدم بالفعل هذا الاختصار."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS ili druga aplikacija već koristi ovaj skraćenik."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS ή άλλη εφαρμογή χρησιμοποιεί ήδη αυτή τη συντόμευση."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS או אפליקציה אחרת כבר משתמשת בקיצור הדרך הזה."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS или другой приложение уже использует этот сокращенный путь."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS lub inna aplikacja już wykorzystuje ten skrót."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS або інша програма вже використовує цю комбінацію клавіш."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS ou une autre application utilise déjà ce raccourci."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS of een andere app gebruikt deze sneltoets al."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS o un'altra app usa già questa scorciatoia."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS tai jokin muu sovellus käyttää jo tätä pikanäppäintä."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS eller en anden app bruger allerede denne genvej."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 또는 다른 앱이 이미 이 단축키를 사용하고 있습니다."
          }
        }
      }
    },
