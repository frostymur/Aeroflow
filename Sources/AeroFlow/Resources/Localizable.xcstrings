    "Move or resize this slot; the window will return here.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このスロットを移動またはサイズ変更してください。ウィンドウはここに戻ります。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verschieben oder vergrößern Sie diese Position; das Fenster wird hierher zurückkehren."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Flytt eller endre størrelsen på dette vinduet; vinduet vil returnere hit."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Flytta eller ändra storleken på den här rutan; fönstret kommer att återvända hit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mueva o rediseñe este espacio; la ventana volverá aquí."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移动或调整这个插槽的大小；窗口将返回这里。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस स्लॉट को स्थानांतरित करें या रीज़ाइज़ करें; विंडो यहाँ वापस आ जाएगी।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتقل أو قم بتوسيع هذا الممر؛ سيعود النافذة إلى هنا."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Premestite ili premestite ovaj slot; prozor će se vratiti ovde."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μετακίνηση ή αλλαγή μεγέθους αυτής της υποδοχή; το παράθυρο θα επιστρέψει εδώ."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הזז או לשנות את גודל החריץ; החלון יחזור לכאן."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переместите или увеличьте этот слот; окно вернётся сюда."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przesuń lub zmień rozmiar tego slotu; okno zwróci się tutaj."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перемістити або змінити розмір цього слоту; вікно повернеться сюди."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déplacez ou redimensionnez cette fente ; la fenêtre reviendra ici."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verplaatsen of wijzigen van deze sleuf; het venster zal hier terugkeren."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sposta o ridimensiona questo slot; la finestra tornerà qui."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Siirrä tai muuta tätä aukkoa, ikkuna palaa tänne."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Flyt eller ændre størrelsen på denne slot; vinduet vil vende tilbage her."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 슬롯을 이동하거나 크기를 조정하면 창이 여기로 돌아갑니다."
          }
        }
      }
    },
